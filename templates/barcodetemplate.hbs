<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <!-- The <title> is injected automatically by your BarcodePdfService -->
    <style>
        body {
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            margin: 0;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }
        .label-container {
            border: 2px dashed #ccc;
            padding: 30px;
            border-radius: 10px;
            width: 350px;
            page-break-inside: avoid;
            margin-bottom: 16px;
        }
        h1 {
            font-size: 24px;
            margin-bottom: 5px;
            color: #333;
        }
        p {
            font-size: 16px;
            color: #666;
            margin-bottom: 20px;
        }
        .barcode-img {
            max-width: 100%;
            height: auto;
        }
    </style>
</head>
<body>
{{#each items}}
    <div class="label-container">
        <h1>{{ productName }}</h1>
        <p>SKU: {{ sku }} | Qty: {{ quantity }}</p>
        <img class="barcode-img" src="{{ barcodeImageBase64 }}" alt="Barcode for {{ sku }}" />
    </div>
{{/each}}
</body>
</html>