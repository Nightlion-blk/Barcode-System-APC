generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model audit_logs {
  audit_id    Int          @id @default(autoincrement())
  user_id     Int?
  event_type  event_status
  module_name String?      @db.VarChar
  description String?
  status      status_enum? @default(pending)
  created_at  DateTime?    @default(now()) @db.Timestamp(6)
  users       users?       @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_audit_user")
}

model barcoded_items {
  barc_id      Int          @id @default(autoincrement())
  barcode_sku  String       @unique @db.VarChar(100)
  prod_name    String       @db.VarChar(255)
  last_updated DateTime?    @default(now()) @db.Timestamp(6)
  quantity     Int?         @default(0)
  status       String?      @db.VarChar(50)
  history      history[]
  print_item   print_item[]
}

model history {
  hist_id        Int             @id @default(autoincrement())
  user_id        Int?
  action_type    history_action?
  created_at     DateTime?       @default(now()) @db.Timestamp(6)
  barc_id        Int?
  barcoded_items barcoded_items? @relation(fields: [barc_id], references: [barc_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_history_baritem")
  users          users?          @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_barc_history")
}

model permission_tbl {
  permission_id   Int       @id @default(autoincrement())
  permission_name String?   @db.VarChar(255)
  description     String?
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  roles           roles[]
}

model print_item {
  notif_id       Int             @id @default(autoincrement())
  user_id        Int?
  barc_id        Int?
  quantity       Int?            @default(0)
  created_at     DateTime?       @default(now()) @db.Timestamp(6)
  completed_at   DateTime?       @db.Timestamp(6)
  barcoded_items barcoded_items? @relation(fields: [barc_id], references: [barc_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_print_item_barcid")
  users          users?          @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_print_item_user")
}

model roles {
  role_id        Int             @id @default(autoincrement())
  role_name      String          @db.VarChar(255)
  status         role_status?    @default(active)
  permission_id  Int?
  permission_tbl permission_tbl? @relation(fields: [permission_id], references: [permission_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_permission_role")
  users          users[]
}

model users {
  user_id       Int          @id @default(autoincrement())
  username      String       @db.VarChar(100)
  password_hash String       @db.VarChar(255)
  first_name    String       @db.VarChar(255)
  last_name     String       @db.VarChar(255)
  created_at    DateTime?    @default(now()) @db.Timestamptz(6)
  status        user_status? @default(inactive)
  approved_by   String?      @db.VarChar(255)
  role_id       Int?
  audit_logs    audit_logs[]
  history       history[]
  print_item    print_item[]
  roles         roles?       @relation(fields: [role_id], references: [role_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_role_users")
}

enum event_status {
  insert
  update
  delete
  login
  failed_login
}

enum history_action {
  item_added
  item_removed
  scanned
  updated
}

enum item_status {
  in_stock
  low_stock
  out_of_stock
}

enum role_status {
  delete
  pending
  active
}

enum status_enum {
  success
  failed
  pending
}

enum user_status {
  active
  inactive
  pending
  deleted
}
